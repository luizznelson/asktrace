POSTGRES_PASSWORD=defina-uma-senha-local

# Opcional: somente para usar --provider gemini; nunca commitar a chave real.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# ASKTRACE_READER_PASSWORD é gerada por: python -m asktrace.query setup-reader

# Contingência opcional: use a conta Groq no plano Free.
GROQ_API_KEY=
# OpenRouter: somente o modelo :free configurado, com preço máximo zero.
OPENROUTER_API_KEY=
# Ordem, modelos e limites: config/providers.json (Ollama desativado por padrão).

# Publicação opcional. Deixar vazios mantém o banco local do Docker.
# ADMIN: somente no computador para importação; NUNCA cadastrar no servidor público.
ASKTRACE_ADMIN_DATABASE_URL=
# Segredos do serviço: credenciais diferentes para leitura e estado operacional.
ASKTRACE_DATABASE_URL=
ASKTRACE_STATE_DATABASE_URL=
ASKTRACE_DATA_SHA256=
# Fora do Render: HTTPS com domínio exato, sem barra final.
ASKTRACE_PUBLIC_ORIGIN=
ASKTRACE_PUBLIC_AI=false
ASKTRACE_DAILY_AI_LIMIT=10
# Passo a passo: docs/deployment.md. Não versionar data/deploy/runtime.env.
